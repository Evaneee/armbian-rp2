menuconfig ROCKCHIP_MPP_SERVICE
	tristate "Rockchip MPP service framework (rkmpp /dev/mpp_service)"
	depends on ARCH_ROCKCHIP
	depends on ROCKCHIP_IOMMU
	help
	  Vendor Rockchip MPP service (rk_vcodec). Provides /dev/mpp_service
	  for librockchip-mpp / ffmpeg rkmpp / mpv hwdec=rkmpp.
	  Ported from rk35xx vendor kernel for mainline/edge on RK3568.

if ROCKCHIP_MPP_SERVICE

config ROCKCHIP_MPP_PROC_FS
	bool "mpp service procfs"
	depends on PROC_FS
	default y

config ROCKCHIP_MPP_RKVDEC2
	bool "RKV decoder v2 (RK3568 rkvdec)"
	default y

config ROCKCHIP_MPP_VDPU2
	bool "VPU decoder v2"
	default y

config ROCKCHIP_MPP_VEPU2
	bool "VPU encoder v2"
	default y

config ROCKCHIP_MPP_JPGDEC
	bool "RKV JPEG decoder v1"
	default y

config ROCKCHIP_MPP_RKVENC
	bool "RKV encoder v1 (RK3568 rkvenc)"
	default y

endif
