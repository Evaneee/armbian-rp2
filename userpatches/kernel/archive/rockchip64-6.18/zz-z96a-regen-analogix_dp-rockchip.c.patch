diff --git a/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c b/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c
index a95af0483ab2..2e51dbd725bb 100644
--- a/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c
+++ b/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c
@@ -9,6 +9,7 @@
  */
 
 #include <linux/cleanup.h>
+#include <linux/media-bus-format.h>
 #include <linux/component.h>
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
@@ -71,6 +72,7 @@ struct rockchip_dp_device {
 	struct drm_display_mode  mode;
 
 	struct clk               *pclk;
+	struct clk               *spdif_clk; /* CLK_EDP_200M — vendor "spdif" */
 	struct clk               *grfclk;
 	struct regmap            *grf;
 	struct reset_control     *rst;
@@ -161,6 +163,7 @@ static int rockchip_dp_powerdown(struct analogix_dp_plat_data *plat_data)
 	if (ret != 0)
 		DRM_DEV_ERROR(dp->dev, "failed to set edp mode %d\n", ret);
 
+	clk_disable_unprepare(dp->spdif_clk);
 	clk_disable_unprepare(dp->pclk);
 
 	return 0;
@@ -317,6 +320,12 @@ rockchip_dp_drm_encoder_atomic_check(struct drm_encoder *encoder,
 	s->output_mode = ROCKCHIP_OUT_MODE_AAAA;
 	s->output_type = DRM_MODE_CONNECTOR_eDP;
 	s->output_bpc = di->bpc;
+	/* Vendor: keep AAAA; VOP cuts to P888 without PRE_DITHER when needed. */
+	s->bus_flags = di->bus_flags;
+	if (di->num_bus_formats)
+		s->bus_format = di->bus_formats[0];
+	else
+		s->bus_format = MEDIA_BUS_FMT_RGB888_1X24;
 
 	return 0;
 }
@@ -357,6 +366,12 @@ static int rockchip_dp_of_probe(struct rockchip_dp_device *dp)
 		return PTR_ERR(dp->pclk);
 	}
 
+	/* Vendor DT names CLK_EDP_200M "spdif"; video path needs it enabled. */
+	dp->spdif_clk = devm_clk_get_optional(dev, "spdif");
+	if (IS_ERR(dp->spdif_clk))
+		return dev_err_probe(dev, PTR_ERR(dp->spdif_clk),
+				     "failed to get spdif/clk_edp_200m\n");
+
 	clk = devm_clk_get_optional_enabled(dev, "hclk");
 	if (IS_ERR(clk))
 		return dev_err_probe(dev, PTR_ERR(clk),
@@ -500,6 +515,7 @@ static int rockchip_dp_probe(struct platform_device *pdev)
 	dp->dev = dev;
 	dp->adp = ERR_PTR(-ENODEV);
 	dp->plat_data.dev_type = dp->data->chip_type;
+	dp->plat_data.ssc = true; /* naneng-edp / vendor rk3568 */
 	dp->plat_data.power_on = rockchip_dp_poweron;
 	dp->plat_data.power_off = rockchip_dp_powerdown;
 	dp->plat_data.get_modes = rockchip_dp_get_modes;
@@ -578,6 +594,14 @@ static const struct rockchip_dp_chip_data rk3288_dp[] = {
 	{ /* sentinel */ }
 };
 
+static const struct rockchip_dp_chip_data rk3568_edp[] = {
+	{
+		.chip_type = RK3568_EDP,
+		.reg = 0xfe0c0000,
+	},
+	{ /* sentinel */ }
+};
+
 static const struct rockchip_dp_chip_data rk3588_edp[] = {
 	{
 		.edp_mode = GRF_REG_FIELD(0x0000, 0, 0),
@@ -595,6 +619,7 @@ static const struct rockchip_dp_chip_data rk3588_edp[] = {
 static const struct of_device_id rockchip_dp_dt_ids[] = {
 	{.compatible = "rockchip,rk3288-dp", .data = &rk3288_dp },
 	{.compatible = "rockchip,rk3399-edp", .data = &rk3399_edp },
+	{.compatible = "rockchip,rk3568-edp", .data = &rk3568_edp },
 	{.compatible = "rockchip,rk3588-edp", .data = &rk3588_edp },
 	{}
 };
