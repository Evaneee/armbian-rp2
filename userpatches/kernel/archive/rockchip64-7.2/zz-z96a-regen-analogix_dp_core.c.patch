+static int analogix_dp_enable_sink_assr(struct analogix_dp_device *dp, bool enable)
+{
+	u8 data;
+	int ret;
+
+	ret = drm_dp_dpcd_readb(&dp->aux, DP_EDP_CONFIGURATION_SET, &data);
+	if (ret != 1)
