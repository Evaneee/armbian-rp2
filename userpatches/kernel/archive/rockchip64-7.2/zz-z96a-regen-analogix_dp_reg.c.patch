+
+bool analogix_dp_ssc_supported(struct analogix_dp_device *dp)
+{
+	return dp->plat_data && dp->plat_data->ssc && dp->link_train.ssc;
+}
+
+void analogix_dp_enable_assr_mode(struct analogix_dp_device *dp, bool enable)
+{
+	u32 reg;
+
+	reg = readl(dp->reg_base + ANALOGIX_DP_LINK_POLICY);
+	if (enable)
+		reg |= ALTERNATE_SR_ENABLE;
+	else
+		reg &= ~ALTERNATE_SR_ENABLE;
+	writel(reg, dp->reg_base + ANALOGIX_DP_LINK_POLICY);
+}
+
+void analogix_dp_video_bist_enable(struct analogix_dp_device *dp)
+{
+	u32 reg;
+
+	writel(BIST_EN, dp->reg_base + ANALOGIX_DP_VIDEO_CTL_4);
+	reg = readl(dp->reg_base + ANALOGIX_DP_VIDEO_CTL_10);
+	reg &= ~FORMAT_SEL;
+	writel(reg, dp->reg_base + ANALOGIX_DP_VIDEO_CTL_10);
+}
