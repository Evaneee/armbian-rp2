+		sys3 |= VALID_CTRL | F_VALID;
+		if (dp->force_hpd)
+			sys3 |= F_HPD | HPD_CTRL;
+		writel(sys3, dp->reg_base + ANALOGIX_DP_SYS_CTL_3);
+		return 0;
+	}
