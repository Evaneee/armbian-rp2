// SPDX-License-Identifier: (GPL-2.0+ OR MIT)

/*
 * Sunniwell Z96A RK3568 laptop — mainline (current/6.18) bring-up DTS.
 * Derived from rk3568-rock-3a.dts; PMIC is RK817 (not Rock 3A's RK809).
 * First goal: boot + serial + regulators + Panfrost path.
 * eDP panel + PWM backlight from vendor 6.1 DTS; unused gmac1 disabled.
 * Battery: SARADC ch1 via z96a,bat-adc (CONFIG_BATTERY_Z96A_ADC). EC keyboard may still be incomplete.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/rk3568-cru.h>
#include <dt-bindings/power/rk3568-power.h>
#include <dt-bindings/usb/pd.h>
#include "rk3568.dtsi"

/ {
	model = "Sunniwell Z96A RK3568 Laptop";
	compatible = "sunniwell,z96a", "rockchip,rk3568";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc1;
		serial2 = &uart2;
	};

	chosen: chosen {
		stdout-path = "serial2:1500000n8";
		/*
		 * eDP fbcon: map:0 → /dev/fb0 (map:1 leaves panel blank).
		 * Mode matches the 1920x1080 panel used on hybrid bring-up.
		 * Full images still override via boot-z96a.cmd; this covers FIT/direct boot.
		 */
		bootargs = "earlycon=uart8250,mmio32,0xfe660000 console=ttyS2,1500000 console=tty1 consoleblank=0 fbcon=map:0 video=eDP-1:1920x1080@60";
	};

	hdmi-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};


	/* SoC eDP (normally in rk356x-base.dtsi; kept board-local for reliable apply) */
	edp_phy_grf: syscon@fdcb0000 {
		compatible = "rockchip,rk3568-edp-phy-grf", "syscon", "simple-mfd";
		reg = <0x0 0xfdcb0000 0x0 0x100>;
		clocks = <&cru PCLK_EDPPHY_GRF>;

		edp_phy: edp-phy {
			compatible = "rockchip,rk3568-edp-phy";
			clocks = <&pmucru XIN_OSC0_EDPPHY_G>;
			clock-names = "refclk";
			#phy-cells = <0>;
			status = "disabled";
		};
	};

	edp: edp@fe0c0000 {
		compatible = "rockchip,rk3568-edp";
		reg = <0x0 0xfe0c0000 0x0 0x10000>;
		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
		/* Vendor: CLK_EDP_200M as "spdif" — required for video path */
		clocks = <&pmucru XIN_OSC0_EDPPHY_G>, <&cru PCLK_EDP_CTRL>,
			 <&cru CLK_EDP_200M>, <&cru HCLK_VO>;
		clock-names = "dp", "pclk", "spdif", "hclk";
		resets = <&cru SRST_EDP_24M>, <&cru SRST_P_EDP_CTRL>;
		reset-names = "dp", "apb";
		phys = <&edp_phy>;
		phy-names = "dp";
		power-domains = <&power RK3568_PD_VO>;
		rockchip,grf = <&grf>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			edp_in: port@0 {
				reg = <0>;
			};

			edp_out: port@1 {
				reg = <1>;
			};
		};
	};



	gmac1_clkin: external-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "gmac1_clkin";
		#clock-cells = <0>;
	};

	/* Hall lid on GPIO0_C6 — SW_LID (userspace blanks; logind ignore suspend). */
	gpio_key_lid: gpio-key-lid {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&mh248_irq_gpio>;

		lid {
			label = "Lid";
			gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
			linux,code = <SW_LID>;
			linux,input-type = <EV_SW>;
			wakeup-source;
			debounce-interval = <20>;
		};
	};

	/*
	 * 2S pack voltage via SoC SARADC ch1 (vendor battery-use-adc path).
	 * Scale: shipping Android bat_res 232/50 → ratio 5640 (see bat-adc-src).
	 * DC jack: GPIO3_PA5 ACTIVE_LOW (not RK_PC0 — that is vcc_mipi).
	 * Driver: bat-adc-src/z96a_bat_adc.c → CONFIG_BATTERY_Z96A_ADC.
	 * DC STATUS: GPIO IRQ + 50ms debounce; capacity still 5s poll + hysteresis.
	 */
	battery_adc: battery-adc {
		compatible = "z96a,bat-adc";
		io-channels = <&saradc 1>;
		io-channel-names = "battery-voltage";
		dc-det-gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&dc_det_pin>;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";

		led_user: led-0 {
			gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			default-state = "on";
			linux,default-trigger = "default-on";
			pinctrl-names = "default";
			pinctrl-0 = <&led_user_en>;
		};
	};

	/*
	 * Vendor codec: AW8737 on HP path (spk-use-hp-channel + spk-ctl GPIO3_PA6),
	 * headset detect GPIO3_PB2. Mainline equivalent = PineTab2 simple-audio-amplifier.
	 */
	rk817-sound {
		compatible = "simple-audio-card";
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "Analog RK817";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphones",
			"Speaker", "Internal Speakers";

		simple-audio-card,routing =
			"MICR", "Mic Jack",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Internal Speakers", "Speaker Amplifier OUTL",
			"Internal Speakers", "Speaker Amplifier OUTR",
			"Speaker Amplifier INL", "HPOL",
			"Speaker Amplifier INR", "HPOR";
		simple-audio-card,hp-det-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_HIGH>;
		simple-audio-card,aux-devs = <&speaker_amp>;
		simple-audio-card,pin-switches = "Internal Speakers";

		simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&rk817>;
		};
	};

	speaker_amp: speaker-amplifier {
		compatible = "simple-audio-amplifier";
		pinctrl-names = "default";
		pinctrl-0 = <&spk_ctl>;
		enable-gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>;
		sound-name-prefix = "Speaker Amplifier";
		VCC-supply = <&vcc5v0_sys>;
	};

	/* Vendor Z96A: WiFi reset on GPIO0_C0 (Rock 3A used GPIO3_D4). */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk817 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <100>;
		power-off-delay-us = <5000000>;
		reset-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
	};

	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
	};

	pcie30_avdd0v9: regulator-pcie30-avdd0v9 {
		compatible = "regulator-fixed";
		regulator-name = "pcie30_avdd0v9";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&vcc3v3_sys>;
	};

	pcie30_avdd1v8: regulator-pcie30-avdd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "pcie30_avdd1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc3v3_sys>;
	};

	/* pi6c pcie clock generator */
	vcc3v3_pi6c_03: regulator-vcc3v3-pi6c-03 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pi6c_03";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_pcie: regulator-vcc3v3-pcie {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio0 RK_PD4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pcie_enable_h>;
		regulator-name = "vcc3v3_pcie";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_sys: regulator-vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb: regulator-vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc12v_dcin>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg_pwr_en>;
	};

	vcc5v0_usb_host: regulator-vcc5v0-usb-host {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio3 RK_PB6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_usb_host_en>;
		regulator-name = "vcc5v0_usb_host";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_usb>;
	};

	vcc5v0_usb_otg: regulator-vcc5v0-usb-otg {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio2 RK_PD5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_usb_otg_en>;
		regulator-name = "vcc5v0_usb_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_usb>;
	};

	/* Keyboard/touchpad combo 5V (USB HID behind Terminus hub). */
	z96a_keyboad_vcc: z96a-keyboad-vcc {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_keyboard_pwr>;
		regulator-name = "z96a_keyboad_vcc";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_cam: regulator-vcc-cam {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio1 RK_PB1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc_cam_en>;
		regulator-name = "vcc_cam";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vcc_mipi: regulator-vcc-mipi {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc_mipi_en>;
		regulator-name = "vcc_mipi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	/*
	 * LCD 3V3 rail. Hybrid log showed regulator "enabled" while GPIO0_PC7
	 * stayed out-lo (ena_gpio_state vs raw level mismatch) — panel/AUX dead
	 * and no backlight glow. Own the pin via gpio-hog (below) and keep this
	 * as a pure always-on supply for consumers.
	 */
	vcc3v3_lcd0_n: vcc3v3-lcd0-n {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_lcd0_n";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm10 0 5000 0>; /* 200 kHz; vendor was 25000 (40 kHz) */
		brightness-levels = <
			  0  20  40  60  80 100 120 140
			160 180 200 220 240 255
		>;
		default-brightness-level = <13>;
		power-supply = <&vcc3v3_lcd0_n>;
	};

	/*
	 * Match vendor panel params (simple-panel): enable-gpios, bus-format,
	 * 20/20 delays, 1920x1080@141.4MHz. Mainline uses panel-dpi binding.
	 */
	edp_panel: edp-panel {
		compatible = "chaoge,z96a-edp", "panel-dpi";
		status = "okay";
		power-supply = <&vcc3v3_lcd0_n>;
		backlight = <&backlight>;
		enable-gpios = <&gpio3 RK_PA3 GPIO_ACTIVE_HIGH>;
		bus-format = <0x100a>; /* MEDIA_BUS_FMT_RGB888_1X24 */
		width-mm = <309>;
		height-mm = <173>;
		bpc = <8>;
		prepare-delay-ms = <20>;
		enable-delay-ms = <20>;

		panel-timing {
			clock-frequency = <141400000>;
			hactive = <1920>;
			vactive = <1080>;
			hfront-porch = <48>;
			hsync-len = <32>;
			hback-porch = <142>;
			vfront-porch = <3>;
			vsync-len = <6>;
			vback-porch = <11>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <0>;
		};

		port {
			panel_in_edp: endpoint {
				remote-endpoint = <&edp_out_panel>;
			};
		};
	};
};

&combphy0 {
	status = "okay";
};

&combphy1 {
	status = "okay";
};

&combphy2 {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

/* Laptop has no wired RGMII; leave disabled to avoid TX watchdog spam. */
&gmac1 {
	status = "disabled";
};

&gpu {
	mali-supply = <&vdd_gpu>;
	status = "okay";
};

/*
 * CPU OC: needs TF-A SCMI PVTPLL 2088/2208 (userpatches atf 1010).
 * Voltages within SYR827 max 1.39V; validated with clk_scmi_cpu.
 */
&cpu0_opp_table {
	opp-2088000000 {
		opp-hz = /bits/ 64 <2088000000>;
		opp-microvolt = <1225000 1225000 1390000>;
		clock-latency-ns = <40000>;
	};
	opp-2208000000 {
		opp-hz = /bits/ 64 <2208000000>;
		opp-microvolt = <1300000 1300000 1390000>;
		clock-latency-ns = <40000>;
	};
};

/* GPU OC: needs TF-A SCMI PVTPLL 900/1000 (userpatches atf 1011). */
&gpu_opp_table {
	opp-900000000 {
		opp-hz = /bits/ 64 <900000000>;
		opp-microvolt = <1050000 1050000 1150000>;
	};
	opp-1000000000 {
		opp-hz = /bits/ 64 <1000000000>;
		opp-microvolt = <1100000 1100000 1150000>;
	};
};

&gpio0 {
		gpio-line-names =
				/* GPIO0_A0 - A7 */
				"", "", "", "", "", "", "", "",
				/* GPIO0_B0 - B7 */
				"", "", "", "pin-28 [GPIO0_B3]", "pin-27 [GPIO0_B4]", "pin-7 [GPIO0_B5]", "pin-16 [GPIO0_B6]", "",
				/* GPIO0_C0 - C7 */
				"", "pin-22 [GPIO0_C1]", "", "", "", "", "", "",
				/* GPIO0_D0 - D7 */
				"pin-10 [GPIO0_D0]", "pin-8 [GPIO0_D1]", "", "", "", "", "", "";

		/* Force LCD 3V3 enable high — was stuck out-lo under regulator-fixed. */
		lcd_vcc_hog: lcd-vcc-hog {
			gpio-hog;
			gpios = <RK_PC7 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "vcc3v3-lcd0-n";
		};
};

&gpio1 {
		gpio-line-names =
				/* GPIO1_A0 - A7 */
				"pin-3 [GPIO1_A0]", "pin-5 [GPIO1_A1]", "", "", "", "", "", "",
				/* GPIO1_B0 - B7 */
				"", "", "", "", "", "", "", "",
				/* GPIO1_C0 - C7 */
				"pin-15 [GPIO0_C0]", "", "", "", "", "", "", "",
				/* GPIO1_D0 - D7 */
				"", "", "", "", "", "", "", "";
};

&gpio2 {
		gpio-line-names =
				/* GPIO2_A0 - A7 */
				"", "", "", "", "", "", "", "",
				/* GPIO2_B0 - B7 */
				"", "", "", "", "", "", "", "",
				/* GPIO2_C0 - C7 */
				"", "", "", "", "", "", "", "",
				/* GPIO2_D0 - D7 */
				"", "", "", "", "", "", "", "pin-29 [GPIO2_D7]";
};

&gpio3 {
		gpio-line-names =
				/* GPIO3_A0 - A7 */
				"pin-31 [GPIO3_A0]", "", "pin-36 [GPIO3_A2]", "pin-12 [GPIO3_A3]", "pin-35 [GPIO3_A4]", "pin-40 [GPIO3_A5]", "pin-38 [GPIO3_A6]", "",
				/* GPIO3_B0 - B7 */
				"", "", "pin-18 [GPIO3_B2]", "", "", "", "", "",
				/* GPIO3_C0 - C7 */
				"", "", "pin-32 [GPIO3_C2]", "pin-33 [GPIO3_C3]", "pin-11 [GPIO3_C4]", "pin-13 [GPIO3_C5]", "", "",
				/* GPIO3_D0 - D7 */
				"", "", "", "", "", "", "", "";

};

&gpio4 {
		gpio-line-names =
				/* GPIO4_A0 - A7 */
				"", "", "", "", "", "", "", "",
				/* GPIO4_B0 - B7 */
				"", "", "", "", "", "", "", "",
				/* GPIO4_C0 - C7 */
				"", "", "pin-21 [GPIO4_C2]", "pin-19 [GPIO4_C3]", "", "pin-21 [GPIO4_C5]", "pin-24 [GPIO4_C6]", "",
				/* GPIO4_D0 - D7 */
				"", "pin-26 [GPIO4_D1]", "", "", "", "", "", "";
};

&edp {
	force-hpd;
	status = "okay";

	ports {
		port@0 {
			reg = <0>;

			/* Vendor: eDP on vp1; VOP keeps AAAA intent (cuts OUT_MODE if needed). */
			edp_in_vp1: endpoint {
				remote-endpoint = <&vp1_out_edp>;
			};
		};

		port@1 {
			reg = <1>;

			edp_out_panel: endpoint {
				remote-endpoint = <&panel_in_edp>;
			};
		};
	};
};

&edp_phy {
	status = "okay";
};

&pwm10 {
	status = "okay";
};

&hdmi {
	avdd-0v9-supply = <&vdda_0v9>;
	avdd-1v8-supply = <&vcc_1v8>;
	status = "okay";
};

&hdmi_in {
	hdmi_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi>;
	};
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&hdmi_sound {
	status = "okay";
};

&i2c0 {
	status = "okay";


	/* Type-C / PD TCPC (vendor @0x22, INT GPIO0_PD5). */
	fusb0: typec-portc@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD5 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&fusb0_int>;
		vbus-supply = <&vcc5v0_usb_otg>;
		status = "okay";

		usb_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			/* Keep 5V-only sink (matches vendor). Higher VBUS needs HW confirm. */
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <10000000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_role_sw: endpoint {
						remote-endpoint = <&usb_host0_xhci_drd_sw>;
					};
				};
			};
		};
	};

	/* Vendor Z96A: Silergy SYR827/837 @0x40 (NOT TCS4525@0x1c / Rock3A). */
	vdd_cpu: regulator@40 {
		compatible = "silergy,syr827";
		reg = <0x40>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1390000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		assigned-clocks = <&cru I2S1_MCLKOUT_TX>;
		assigned-clock-parents = <&cru CLK_I2S1_8CH_TX>;
		#clock-cells = <1>;
		clock-names = "mclk";
		clocks = <&cru I2S1_MCLKOUT_TX>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>, <&i2s1m0_mclk>;
		system-power-controller;
		#sound-dai-cells = <0>;
		vcc1-supply = <&vcc3v3_sys>;
		vcc2-supply = <&vcc3v3_sys>;
		vcc3-supply = <&vcc3v3_sys>;
		vcc4-supply = <&vcc3v3_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;
		vcc8-supply = <&vcc3v3_sys>;
		vcc9-supply = <&vcc3v3_sys>;
		wakeup-source;

		/* Parsed by rk817-codec (child name must be "codec"). */
		codec {
			rockchip,mic-in-differential;
		};

		/*
		 * RK817 rail map from vendor z96a DTS (NOT Rock 3A / RK809).
		 * RK817 has no DCDC_REG5 / SWITCH_REG*; those phandles never
		 * register → eMMC vmmc defer + "vdd_npu: disabling" killing DCDC4.
		 */
		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_gpu: DCDC_REG2 {
				regulator-name = "vdd_gpu";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_3v3: DCDC_REG4 {
				regulator-name = "vcc_3v3";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcca1v8_pmu: LDO_REG1 {
				regulator-name = "vcca1v8_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdda_0v9: LDO_REG2 {
				regulator-name = "vdda_0v9";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-name = "vdda0v9_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vccio_acodec: LDO_REG4 {
				regulator-name = "vccio_acodec";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-name = "vccio_sd";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-name = "vcc3v3_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_1v8: LDO_REG7 {
				regulator-name = "vcc_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc1v8_dvp: LDO_REG8 {
				regulator-name = "vcc1v8_dvp";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc2v8_dvp: LDO_REG9 {
				regulator-name = "vcc2v8_dvp";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			dcdc_boost: BOOST {
				regulator-name = "boost";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m1_xfer>;
	status = "disabled";
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m1_xfer>;
	status = "disabled";
};

&i2c5 {
	status = "okay";

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD3 IRQ_TYPE_LEVEL_LOW>;
		#clock-cells = <0>;
		clock-output-names = "rtcic_32kout";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		wakeup-source;
	};
};

&i2s0_8ch {
	status = "okay";
};

&i2s1_8ch {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1m0_sclktx &i2s1m0_lrcktx &i2s1m0_sdi0 &i2s1m0_sdo0>;
	rockchip,trcm-sync-tx-only;
	status = "okay";
};

&i2s2_2ch {
	rockchip,trcm-sync-tx-only;
	status = "okay";
};

&mdio1 {
	rgmii_phy1: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <&eth_phy_rst>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
	};
};

/* Bring-up: PCIe PHY not ready on this DTS — disable to stop deferred spam. */
&pcie2x1 {
	status = "disabled";
};

&pcie30phy {
	status = "disabled";
};

&pcie3x2 {
	status = "disabled";
};

&pinctrl {

	mh248 {
		mh248_irq_gpio: mh248-irq-gpio {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	cam {
		vcc_cam_en: vcc_cam_en {
			rockchip,pins = <1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	display {
		vcc_mipi_en: vcc_mipi_en {
			rockchip,pins = <3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	ethernet {
		eth_phy_rst: eth_phy_rst {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	hym8563 {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	leds {
		led_user_en: led_user_en {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	power {
		/* Vendor dc_det — ACTIVE_LOW jack sense (pull-up). */
		dc_det_pin: dc-det-pin {
			rockchip,pins = <3 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	pcie {
		pcie_enable_h: pcie-enable-h {
			rockchip,pins = <0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie_reset_h: pcie-reset-h {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic_int {
			rockchip,pins =
				<0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	usb {
		vcc5v0_usb_host_en: vcc5v0_usb_host_en {
			rockchip,pins = <3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		vcc5v0_otg_pwr_en: vcc5v0-otg-pwr-en {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		vcc5v0_usb_otg_en: vcc5v0_usb_otg_en {
			rockchip,pins = <2 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		z96a_keyboard_pwr: z96a-keyboard-pwr {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	/*
	 * Vendor wireless-bluetooth GPIOs (NOT Rock 3A GPIO4_*):
	 *   BT reset / wifi enable share GPIO0_PC1 — keep high via wifi_enable
	 *   (do NOT bind serdev enable-gpios to PC1; a reset pulse kills SDIO WiFi).
	 *   BT wake GPIO0_PB6, host-wake GPIO0_PC4 (shared with wifi host-wake).
	 */
	bt {
		bt_wake: bt-wake {
			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_host_wake: bt-host-wake {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	sdio-pwrseq {
		/* Hold combo-chip enable high (vendor BT reset shares this pad). */
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	sound {
		hp_det: hp-det {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		spk_ctl: spk-ctl {
			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	fusb30x {
		fusb0_int: fusb0-int {
			rockchip,pins = <0 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

};

&pmu_io_domains {
	/* Match vendor z96a io-domain supplies. */
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcca1v8_pmu>;
	vccio1-supply = <&vccio_acodec>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcca1v8_pmu>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc1v8_dvp>;
	vccio7-supply = <&vcc_3v3>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

/* eMMC: vcc_3v3 is RK817 DCDC_REG4 on this board (vendor map).
 * HS400 left disabled: board dropped to initramfs after enabling it (2026-10-05).
 */
&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <200000000>;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe &emmc_rstnout>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

/* Vendor DTS disables sdmmc0 (no usable SD slot path on this laptop). */
&sdmmc0 {
	status = "disabled";
};

/*
 * WiFi (RTL8821CS) is on sdmmc1 in vendor DTS, not Rock 3A's sdmmc2.
 * Disable Rock 3A sdmmc2 to avoid long SDIO timeouts during bring-up.
 */
&sdmmc2 {
	status = "disabled";
};

&sdmmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
	sd-uhs-sdr104;
	status = "okay";
};

/* Z96A boots from eMMC; SFC SPI NOR unused and fspi-pins conflicts (gpio1-23). */
&sfc {
	status = "disabled";
};

&tsadc {
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <0>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
	uart-has-rtscts;
	status = "okay";

	/*
	 * Vendor bluetooth-platdata → mainline H5 serdev (Anbernic RGXX3 pattern).
	 * No enable-gpios: PC1 is shared wifi enable (held high by sdio_pwrseq pinctrl).
	 */
	bluetooth {
		compatible = "realtek,rtl8821cs-bt", "realtek,rtl8723bs-bt";
		device-wake-gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
		host-wake-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_wake &bt_host_wake>;
	};
};

&uart2 {
	status = "okay";
};

/* USB2 + USB3: combphy already okay; xHCI on with Type-C role-switch on host0. */
&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";

	port {
		usb_host0_xhci_drd_sw: endpoint {
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usb_host1_xhci {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_host {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

/*
 * Type-C VBUS is owned by FUSB302 (vbus-supply). Do NOT bind phy-supply here —
 * usb2phy otg-port would keep vcc5v0_usb_otg always on and fight a PD charger.
 */
&usb2phy0_otg {
	status = "okay";
};

&usb2phy1 {
	status = "okay";
};

&usb2phy1_host {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&usb2phy1_otg {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

/*
	 * DCLK_VOP* is CLK_SET_RATE_NO_REPARENT without SET_RATE_PARENT, so it
	 * cannot pull VPLL/HPLL out of 24 MHz slow mode by itself. Bootstrap
	 * the PLLs to a table rate; modeset then divides to ~148.5 / 141.4 MHz.
	 */
&cru {
	assigned-clocks = <&cru PLL_VPLL>;
	assigned-clock-rates = <594000000>;
};

&pmucru {
	assigned-clocks = <&pmucru PLL_HPLL>;
	assigned-clock-rates = <594000000>;
};



&vop {
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp0 {
	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi_in_vp0>;
	};
};

&vp1 {
	vp1_out_edp: endpoint@ROCKCHIP_VOP2_EP_EDP0 {
		reg = <ROCKCHIP_VOP2_EP_EDP0>;
		remote-endpoint = <&edp_in_vp1>;
	};
};

/* Board-level claim: mainline rockchip-rga (/dev/video0). */
&rga {
	status = "okay";
};

/* Rockchip MPP (rkmpp): claim VPU silicon; disable conflicting V4L2 nodes */
&vpu {
	status = "disabled";
};

&vepu {
	status = "disabled";
};

&vdec {
	status = "disabled";
};

&mpp_srv {
	status = "okay";
};

&vdpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vepu_mpp {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};
