From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Tue, 12 Mar 2024 10:33:55 +0800
Subject: Patching kernel rockchip-rk3568-z96a files
 arch/arm64/kernel/hyp-stub.S mm/ioremap.c

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 arch/arm64/kernel/hyp-stub.S | 2 ++
 mm/ioremap.c                 | 1 +
 2 files changed, 3 insertions(+)

diff --git a/arch/arm64/kernel/hyp-stub.S b/arch/arm64/kernel/hyp-stub.S
index 05d25e645b46..2ba73ff06d1f 100644
--- a/arch/arm64/kernel/hyp-stub.S
+++ b/arch/arm64/kernel/hyp-stub.S
@@ -13,10 +13,11 @@
 #include <asm/el2_setup.h>
 #include <asm/kvm_arm.h>
 #include <asm/kvm_asm.h>
 #include <asm/ptrace.h>
 #include <asm/virt.h>
+#include <asm-generic/export.h>
 
 	.text
 	.pushsection	.hyp.text, "ax"
 
 	.align 11
@@ -40,10 +41,11 @@ SYM_CODE_START(__hyp_stub_vectors)
 	ventry	el1_sync_invalid		// Synchronous 32-bit EL1
 	ventry	el1_irq_invalid			// IRQ 32-bit EL1
 	ventry	el1_fiq_invalid			// FIQ 32-bit EL1
 	ventry	el1_error_invalid		// Error 32-bit EL1
 SYM_CODE_END(__hyp_stub_vectors)
+EXPORT_SYMBOL_GPL(__hyp_stub_vectors)
 
 	.align 11
 
 SYM_CODE_START_LOCAL(el1_sync)
 	cmp	x0, #HVC_SET_VECTORS
diff --git a/mm/ioremap.c b/mm/ioremap.c
index 5fa1ab41d152..d63c4ba067f9 100644
--- a/mm/ioremap.c
+++ b/mm/ioremap.c
@@ -246,10 +246,11 @@ int ioremap_page_range(unsigned long addr,
 	if (mask & ARCH_PAGE_TABLE_SYNC_MASK)
 		arch_sync_kernel_mappings(start, end);
 
 	return err;
 }
+EXPORT_SYMBOL_GPL(ioremap_page_range);
 
 #ifdef CONFIG_GENERIC_IOREMAP
 void __iomem *ioremap_prot(phys_addr_t addr, size_t size, unsigned long prot)
 {
 	unsigned long offset, vaddr;
-- 
