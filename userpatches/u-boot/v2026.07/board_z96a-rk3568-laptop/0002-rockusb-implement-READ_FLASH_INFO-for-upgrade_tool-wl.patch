+/*
+ * Matches rkdeveloptool STRUCT_FLASHINFO_CMD (first 11 bytes).
+ * upgrade_tool / rkdeveloptool wl always query this before WriteLBA.
+ */
+struct rockusb_flash_info {
+	u32 flash_size;		/* sector count (desc->lba) */
+	u16 block_size;
+	u8 page_size;
+	u8 ecc_bits;
+	u8 access_time;
+	u8 manufacturer;
+	u8 flash_mask;
+} __packed;
+
+static void cb_read_flash_info(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	struct rockusb_flash_info finfo;
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+
+	if (!f_rkusb->desc) {
+		char *type = f_rkusb->dev_type;
+		int index = f_rkusb->dev_index;
+
+		f_rkusb->desc = blk_get_dev(type, index);
+		if (!f_rkusb->desc ||
+		    f_rkusb->desc->type == DEV_TYPE_UNKNOWN) {
+			printf("invalid device \"%s\", %d\n", type, index);
+			rockusb_tx_write_csw(cbw->tag, 0, CSW_FAIL,
+					     USB_BULK_CS_WRAP_LEN);
+			return;
+		}
+	}
+
+	memset(&finfo, 0, sizeof(finfo));
+	/* Values match Rockchip vendor rockusb eMMC defaults */
+	finfo.flash_size = (u32)f_rkusb->desc->lba;
+	finfo.block_size = 1024;
+	finfo.page_size = 4;
+	finfo.ecc_bits = 0;
+	finfo.access_time = 40;
+	finfo.manufacturer = 0;
+	if (finfo.flash_size)
+		finfo.flash_mask = 1;
+
+	printf("read flash info: sectors=%u\n", finfo.flash_size);
+
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+
+	rockusb_tx_write((char *)&finfo, sizeof(finfo));
+}
