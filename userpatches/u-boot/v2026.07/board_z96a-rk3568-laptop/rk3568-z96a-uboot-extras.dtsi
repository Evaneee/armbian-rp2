/*
 * Z96A laptop U-Boot extras — included from arch/arm/dts/rk3568-z96a-u-boot.dtsi
 * Keyboard/touchpad USB HID power + eDP panel path for Radxa DRM port.
 */

/* U-Boot boots from eMMC only; skip empty SD + WiFi SDIO probes */
&sdmmc0 {
	status = "disabled";
};

&sdmmc2 {
	status = "disabled";
};

/ {
	/* Keyboard/touchpad combo 5V (USB HID behind Terminus hub). */
	z96a_keyboad_vcc: z96a-keyboad-vcc {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_keyboard_pwr>;
		regulator-name = "z96a_keyboad_vcc";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * LCD 3V3 rail enable is GPIO0_PC7 (vendor + mainline). Without driving
	 * this high the panel never powers and Analogix AUX/DPCD times out (-110).
	 * Same fixed-regulator+gpio pattern as z96a_keyboad_vcc.
	 */
	vcc3v3_lcd0_n: vcc3v3-lcd0-n {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_lcd0_n";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_lcd_vcc_en>;
		vin-supply = <&vcc3v3_sys>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm10 0 5000 0>;
		brightness-levels = <
			  0  20  40  60  80 100 120 140
			160 180 200 220 240 255
		>;
		default-brightness-level = <13>;
		power-supply = <&vcc3v3_lcd0_n>;
	};

	/*
	 * SoC eDP (missing from mainline U-Boot rk356x-base.dtsi).
	 * Clock/reset IDs match Linux rk3568-z96a.dts.
	 */
	edp_phy_grf: syscon@fdcb0000 {
		compatible = "rockchip,rk3568-edp-phy-grf", "syscon", "simple-mfd";
		reg = <0x0 0xfdcb0000 0x0 0x100>;
		clocks = <&cru PCLK_EDPPHY_GRF>;

		edp_phy: edp-phy {
			compatible = "rockchip,rk3568-edp-phy";
			clocks = <&pmucru XIN_OSC0_EDPPHY_G>;
			clock-names = "refclk";
			#phy-cells = <0>;
			status = "okay";
		};
	};

	edp: edp@fe0c0000 {
		compatible = "rockchip,rk3568-edp";
		reg = <0x0 0xfe0c0000 0x0 0x10000>;
		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&pmucru XIN_OSC0_EDPPHY_G>, <&cru PCLK_EDP_CTRL>,
			 <&cru CLK_EDP_200M>, <&cru HCLK_VO>;
		clock-names = "dp", "pclk", "spdif", "hclk";
		resets = <&cru SRST_EDP_24M>, <&cru SRST_P_EDP_CTRL>;
		reset-names = "dp", "apb";
		phys = <&edp_phy>;
		phy-names = "dp";
		power-domains = <&power RK3568_PD_VO>;
		rockchip,grf = <&grf>;
		force-hpd;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			edp_in: port@0 {
				reg = <0>;

				edp_in_vp1: endpoint {
					remote-endpoint = <&vp1_out_edp>;
				};
			};

			edp_out: port@1 {
				reg = <1>;

				edp_out_panel: endpoint {
					remote-endpoint = <&panel_in_edp>;
				};
			};
		};
	};

	edp_panel: edp-panel {
		compatible = "simple-panel";
		status = "okay";
		power-supply = <&vcc3v3_lcd0_n>;
		backlight = <&backlight>;
		enable-gpios = <&gpio3 RK_PA3 GPIO_ACTIVE_HIGH>;
		/* Give panel VDD/HPD time before AUX (Linux uses 20ms; be safer). */
		prepare-delay-ms = <100>;
		/* Wait for a clean black frame / stream before lighting backlight. */
		enable-delay-ms = <150>;
		bus-format = <0x100a>; /* MEDIA_BUS_FMT_RGB888_1X24 */
		bpc = <8>;

		display-timings {
			native-mode = <&timing0>;
			timing0: timing0 {
				clock-frequency = <141400000>;
				hactive = <1920>;
				vactive = <1080>;
				hfront-porch = <48>;
				hback-porch = <142>;
				hsync-len = <32>;
				vfront-porch = <3>;
				vback-porch = <11>;
				vsync-len = <6>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		port {
			panel_in_edp: endpoint {
				remote-endpoint = <&edp_out_panel>;
			};
		};
	};
};

&pinctrl {
	usb {
		/* Match Linux/vendor: drive enable pins high at pinctrl apply. */
		z96a_keyboard_pwr: z96a-keyboard-pwr {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_output_high>;
		};
		z96a_vcc5v0_usb_en: z96a-vcc5v0-usb-en {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_output_high>;
		};
		z96a_vcc5v0_usb_host_en: z96a-vcc5v0-usb-host-en {
			rockchip,pins = <3 RK_PB6 RK_FUNC_GPIO &pcfg_output_high>;
		};
		z96a_vcc5v0_usb_otg_en: z96a-vcc5v0-usb-otg-en {
			rockchip,pins = <2 RK_PD5 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	lcd {
		z96a_lcd_vcc_en: z96a-lcd-vcc-en {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/*
 * Rock-3A base DTS uses wrong USB VBUS GPIOs for Z96A (PA5/PA6/PD5 on gpio0).
 * Override to vendor/mainline pins so host PHYs actually get 5V and the
 * keyboard Terminus hub on usb_host1 can enumerate.
 */
&vcc5v0_usb {
	enable-active-high;
	gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&z96a_vcc5v0_usb_en>;
	regulator-always-on;
	regulator-boot-on;
};

&vcc5v0_usb_host {
	enable-active-high;
	gpio = <&gpio3 RK_PB6 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&z96a_vcc5v0_usb_host_en>;
	regulator-always-on;
	regulator-boot-on;
	vin-supply = <&vcc5v0_usb>;
};

&vcc5v0_usb_otg {
	enable-active-high;
	gpio = <&gpio2 RK_PD5 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&z96a_vcc5v0_usb_otg_en>;
	regulator-always-on;
	regulator-boot-on;
	vin-supply = <&vcc5v0_usb>;
};

/* Rock-3A hub rail (GPIO0_PD5) is not this board — leave it off. */
&vcc5v0_usb_hub {
	status = "disabled";
};

/* Z96A laptop has no RJ45 — rock-3a gmac1 must stay off. */
&gmac1 {
	status = "disabled";
};

/*
 * Keyboard hub enumerates on usb_host1 EHCI (fd880000). OHCI companions
 * probe empty/phantom LS ports and spam:
 *   ERROR: USB-error: DEVICENOTRESPONDING …
 *   unable to get device descriptor
 * Keep OHCI off. Enable USB3 xHCI so Type-C / USB3 ports see mass-storage.
 */
&usb_host0_ohci {
	status = "disabled";
};

&usb_host0_xhci {
	extcon = <&usb2phy0>;
	dr_mode = "host";
	status = "okay";
};

&usb_host1_ohci {
	status = "disabled";
};

&usb_host1_xhci {
	dr_mode = "host";
	status = "okay";
};

/* USB3 needs combphy (rock-3a already okay; keep explicit for Z96A). */
&combphy0 {
	status = "okay";
};

&combphy1 {
	status = "okay";
};

&combphy2 {
	status = "okay";
};

&pwm10 {
	status = "okay";
};

&hdmi {
	status = "disabled";
};

/*
 * Bind display-subsystem before relocation so video_reserve() sees plat->size.
 * Without this, post-reloc alloc fails: "cannot allocate frame buffer memory".
 *
 * Radxa DRM probe requires route/route-edp with connect=<vp endpoint>;
 * missing route → stdio_add_devices: Failed to probe … (ret=-19 / -ENODEV).
 */
&display_subsystem {
	bootph-all;
	bootph-pre-ram;

	route {
		route_edp: route-edp {
			status = "okay";
			logo,uboot = "logo.bmp";
			logo,kernel = "logo_kernel.bmp";
			logo,mode = "center";
			charge_logo,mode = "center";
			connect = <&vp1_out_edp>;
		};
	};
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp1 {
	vp1_out_edp: endpoint@ROCKCHIP_VOP2_EP_EDP0 {
		reg = <ROCKCHIP_VOP2_EP_EDP0>;
		remote-endpoint = <&edp_in_vp1>;
	};
};
