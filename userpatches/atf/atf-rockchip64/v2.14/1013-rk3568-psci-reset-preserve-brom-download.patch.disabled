Subject: [PATCH] rk3568: Maskrom PSCI reset (remap+flag, stock reset sequence)

--- a/plat/rockchip/rk3568/drivers/soc/soc.c
+++ b/plat/rockchip/rk3568/drivers/soc/soc.c
@@ -64,22 +64,44 @@
 	mmio_write_32(CRU_BASE + CRU_MODE_CON00, 0x03 << (16 + clk_pll * 2));
 }
 
+static void z96a_uart2_puts(const char *s)
+{
+	for (; *s; s++) {
+		while ((mmio_read_32(0xfe660014) & 0x20U) == 0U)
+			;
+		mmio_write_32(0xfe660000, *s);
+	}
+}
+
 static void __dead2 soc_global_soft_reset(void)
 {
+	bool maskrom = (mmio_read_32(PMUGRF_BASE + 0x200) == 0xEF08A53CU);
+
+	/* pmu.c left remap=PMU_SRAM; force BootROM vector. */
+	mmio_write_32(PMUSGRF_BASE + 0x0, 0x04000000);
+	mmio_write_32(PMUSGRF_BASE + 0x4, 0x18000000);
+	/* Preserve OS_REG0 across reset (only bit2). */
+	mmio_write_32(PMUGRF_BASE + 0x104, 0x00040000);
+	mmio_write_32(0xfdcc0010, 0);
+
+	if (maskrom) {
+		mmio_write_32(PMUGRF_BASE + 0x200, 0xEF08A53C);
+		z96a_uart2_puts("ATF-MASKROM\r\n");
+	} else {
+		z96a_uart2_puts("ATF-RESET\r\n");
+	}
+
 	set_pll_slow_mode(CLK_CPLL);
 	set_pll_slow_mode(CLK_GPLL);
 	set_pll_slow_mode(CLK_NPLL);
 	set_pll_slow_mode(CLK_VPLL);
 	set_pll_slow_mode(CLK_USBPLL);
 	set_pll_slow_mode(CLK_APLL);
 	mmio_write_32(PMUCRU_BASE + PMUCRU_MODE_CON00, 0x000f0000);
 
+	z96a_uart2_puts("SRST-FST\r\n");
 	dsb();
 	mmio_write_32(CRU_BASE + CRU_GLB_SRST_FST, GLB_SRST_FST_CFG_VAL);
-	/*
-	 * Maybe the HW needs some times to reset the system,
-	 * so we do not hope the core to excute valid codes.
-	 */
 	while (1) {
 		;
 	}
