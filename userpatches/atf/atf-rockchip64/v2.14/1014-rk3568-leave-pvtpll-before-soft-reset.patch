Subject: [PATCH] rk3568: leave PVTPLL before global soft reset

sys_reset_pvtplls_prepare() exists but is never called. With the CPU on
PVTPLL (SCMI cpufreq or early 1416 MHz clk init), PSCI SYSTEM_RESET hangs
before BootROM. Switch back to normal PLLs and stop the PVTPLL rings.

--- a/plat/rockchip/rk3568/drivers/scmi/rk3568_clk.h	2026-10-10 22:18:20.652835946 +0800
+++ b/plat/rockchip/rk3568/drivers/scmi/rk3568_clk.h	2026-10-10 22:18:20.658836060 +0800
@@ -66,6 +66,7 @@
 
 void pvtplls_suspend(void);
 void pvtplls_resume(void);
+void sys_reset_pvtplls_prepare(void);
 void rockchip_clock_init(void);
 
 #endif /* RK3568_CLOCK_H */
--- a/plat/rockchip/rk3568/drivers/soc/soc.c	2026-10-10 22:18:20.649835890 +0800
+++ b/plat/rockchip/rk3568/drivers/soc/soc.c	2026-10-10 22:18:20.660836098 +0800
@@ -66,6 +66,15 @@
 
 static void __dead2 soc_global_soft_reset(void)
 {
+	/*
+	 * Move CPU/GPU/NPU off PVTPLL and stop the rings: CPU_GRF/GRF PVTPLL
+	 * state survives GLB_SRST_FST and BootROM never comes back otherwise.
+	 */
+	sys_reset_pvtplls_prepare();
+	mmio_write_32(CPUGRF_BASE + 0x10, 0xffff0000);
+	mmio_write_32(GRF_BASE + 0x700, 0xffff0000);
+	mmio_write_32(GRF_BASE + 0x740, 0xffff0000);
+
 	set_pll_slow_mode(CLK_CPLL);
 	set_pll_slow_mode(CLK_GPLL);
 	set_pll_slow_mode(CLK_NPLL);
