--- a/plat/rockchip/rk3568/drivers/scmi/rk3568_clk.c
+++ b/plat/rockchip/rk3568/drivers/scmi/rk3568_clk.c
@@ -156,6 +156,9 @@
 }
 
 static struct pvtpll_table rk3568_cpu_pvtpll_table[] = {
+	/* OC: vendor clk-rk3568 APLL 24*87 / 24*92 — may be unstable */
