#!/usr/bin/env bash
# USB ADB gadget bring-up for Z96A (configfs + FunctionFS + adbd).
#
# Board-tested (2026-10-09):
# - Stay on USB2 high-speed. SuperSpeed rewrites bMaxPacketSize0 to 0x09
#   (USB3 encoding) and breaks VMware/xHCI set-config (error -32 / Invalid ep0).
# - Force OTG role=device before bind.
# - adbd must start before UDC bind so FunctionFS endpoints exist.

set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
GADGET_NAME="${GADGET_NAME:-z96a-adb}"
CONFIGFS="/sys/kernel/config"
GADGET_DIR="${CONFIGFS}/usb_gadget/${GADGET_NAME}"
FFS_MOUNT="/dev/usb-ffs/adb"
if [[ -x "${HERE}/adbd" ]]; then
	ADBD_BIN="${ADBD_BIN:-${HERE}/adbd}"
else
	ADBD_BIN="${ADBD_BIN:-/usr/local/bin/adbd}"
fi

die() { echo "z96a-adb: $*" >&2; exit 1; }

need_root() {
	[[ "$(id -u)" -eq 0 ]] || die "run as root: sudo $0 $*"
}

ensure_modules() {
	modprobe libcomposite 2>/dev/null || true
	modprobe usb_f_fs 2>/dev/null || true
	[[ -d "${CONFIGFS}/usb_gadget" ]] || mount -t configfs none "${CONFIGFS}" 2>/dev/null || true
	[[ -d "${CONFIGFS}/usb_gadget" ]] || die "configfs usb_gadget missing"
	[[ -x "${ADBD_BIN}" ]] || die "missing executable adbd: ${ADBD_BIN}"
}

force_device_role() {
	local rolep
	for rolep in /sys/class/usb_role/*/role /sys/devices/platform/*/usb_role/*/role; do
		if [[ -e "${rolep}" ]]; then
			echo device > "${rolep}" 2>/dev/null || true
		fi
	done
}

pick_udc() {
	local udc
	udc="$(ls /sys/class/udc 2>/dev/null | head -n1 || true)"
	[[ -n "${udc}" ]] || die "no UDC in /sys/class/udc"
	echo "${udc}"
}

fix_hs_descriptors() {
	# Must run inside ${GADGET_DIR}
	echo 0x0200 > bcdUSB
	printf '64\n' > bMaxPacketSize0
	if [[ -e max_speed ]]; then
		echo high-speed > max_speed
	fi
}

gadget_is_healthy() {
	local mps bcd ms
	[[ -f "${GADGET_DIR}/UDC" ]] || return 1
	[[ -n "$(cat "${GADGET_DIR}/UDC" 2>/dev/null || true)" ]] || return 1
	mps="$(cat "${GADGET_DIR}/bMaxPacketSize0" 2>/dev/null || true)"
	bcd="$(cat "${GADGET_DIR}/bcdUSB" 2>/dev/null || true)"
	ms="$(cat "${GADGET_DIR}/max_speed" 2>/dev/null || true)"
	[[ "${mps}" == "64" || "${mps}" == "0x40" ]] || return 1
	[[ "${bcd}" == "0x200" || "${bcd}" == "0x0200" ]] || return 1
	# max_speed may be absent on older kernels; if present require HS
	if [[ -n "${ms}" && "${ms}" != "high-speed" && "${ms}" != "full-speed" ]]; then
		return 1
	fi
	pgrep -x adbd >/dev/null 2>&1 || return 1
	return 0
}

do_start() {
	need_root start
	ensure_modules
	force_device_role

	if gadget_is_healthy; then
		echo "z96a-adb: already bound to UDC $(cat "${GADGET_DIR}/UDC") (HS OK)"
		return 0
	fi

	[[ -d "${GADGET_DIR}" ]] && { do_stop || true; }

	mkdir -p "${GADGET_DIR}"
	cd "${GADGET_DIR}"

	echo 0x0200 > bcdUSB
	echo 0x0100 > bcdDevice
	# HS ep0 must be 8/16/32/64 — never 0x09 (USB3 SS encoding)
	printf '64\n' > bMaxPacketSize0
	# Stay on USB2 HS (SS breaks VMware / set-config)
	[[ -e max_speed ]] && echo high-speed > max_speed
	echo 0x0888 > idVendor
	echo 0x0888 > idProduct

	mkdir -p strings/0x409
	echo "76543210" > strings/0x409/serialnumber
	echo "Sunniwell" > strings/0x409/manufacturer
	echo "z96a" > strings/0x409/product

	mkdir -p configs/config.1/strings/0x409
	echo 120 > configs/config.1/MaxPower
	echo "z96acfg" > configs/config.1/strings/0x409/configuration

	mkdir -p functions/ffs.adb
	ln -sfn functions/ffs.adb configs/config.1/

	mkdir -p "${FFS_MOUNT}"
	mountpoint -q "${FFS_MOUNT}" || mount -t functionfs adb "${FFS_MOUNT}"

	if ! pgrep -x adbd >/dev/null 2>&1; then
		"${ADBD_BIN}" &
		disown || true
	fi
	sleep 2

	fix_hs_descriptors

	local udc
	udc="$(pick_udc)"
	echo "${udc}" > UDC
	echo "z96a-adb: started (UDC=${udc} max_speed=$(cat max_speed 2>/dev/null || echo n/a) bMax=$(cat bMaxPacketSize0))"
	echo "On PC: adb devices"
}

do_stop() {
	need_root stop
	if [[ -d "${GADGET_DIR}" ]]; then
		cd "${GADGET_DIR}"
		# UDC unbind can block on dwc3; never hang forever
		if [[ -f UDC ]]; then
			timeout 3 sh -c 'echo "" > UDC' 2>/dev/null || true
		fi
		rm -f configs/config.1/ffs.adb 2>/dev/null || true
		rmdir functions/ffs.adb 2>/dev/null || true
		rmdir configs/config.1/strings/0x409 2>/dev/null || true
		rmdir configs/config.1 2>/dev/null || true
		rmdir strings/0x409 2>/dev/null || true
		cd /
		rmdir "${GADGET_DIR}" 2>/dev/null || true
	fi
	killall -9 adbd 2>/dev/null || true
	mountpoint -q "${FFS_MOUNT}" 2>/dev/null && timeout 3 umount -f "${FFS_MOUNT}" 2>/dev/null || true
	echo "z96a-adb: stopped"
}

do_status() {
	echo "bundle: ${HERE}"
	echo "adbd:   ${ADBD_BIN}"
	echo "UDC:    $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
	if [[ -f "${GADGET_DIR}/UDC" ]]; then
		echo "bound:  $(cat "${GADGET_DIR}/UDC")"
		echo "bMax:   $(cat "${GADGET_DIR}/bMaxPacketSize0" 2>/dev/null || echo '?')"
		echo "bcdUSB: $(cat "${GADGET_DIR}/bcdUSB" 2>/dev/null || echo '?')"
		echo "max_speed: $(cat "${GADGET_DIR}/max_speed" 2>/dev/null || echo n/a)"
		echo "current_speed: $(cat /sys/class/udc/*/current_speed 2>/dev/null | head -1 || echo '?')"
	else
		echo "bound:  (no)"
	fi
	pgrep -x adbd >/dev/null 2>&1 && echo "adbd:   running" || echo "adbd:   stopped"
}

case "${1:-}" in
	start) do_start ;;
	stop) do_stop ;;
	status) do_status ;;
	restart) do_stop || true; do_start ;;
	*) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
