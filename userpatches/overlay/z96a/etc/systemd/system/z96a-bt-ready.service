[Unit]
Description=Z96A Bluetooth bring-up (deferred after desktop)
# Do not block multi-user/graphical boot — run after GDM is up.
After=graphical.target
Wants=z96a-bt-fw-link.service
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=oneshot
ExecStart=/etc/z96a/z96a-bt
RemainAfterExit=yes
TimeoutStartSec=60
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
