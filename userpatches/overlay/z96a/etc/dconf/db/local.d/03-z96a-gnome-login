# DING kept disabled for compositor/scanout; dock + appindicators only.
[org/gnome/shell]
enabled-extensions=['ubuntu-dock@ubuntu.com', 'ubuntu-appindicators@ubuntu.com']
disabled-extensions=['ding@rastersoft.com']

[org/gnome/desktop/interface]
enable-animations=false

[org/gnome/mutter]
# Prefer lower compositor overhead during session start
experimental-features=@as []
