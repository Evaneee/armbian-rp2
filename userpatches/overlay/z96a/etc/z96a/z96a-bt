#!/bin/bash
# Z96A RTL8821CS Bluetooth bring-up
#
# btmgmt under systemd cannot epoll stdin (/dev/null -> EPERM) and hangs forever.
# Feeding a closed pipe (`: | btmgmt ...`) makes epoll see HUP and proceed.
#
# RTL8821CS fw 0xaa8a930d rejects HCI Write Secure Connections Host Support
# (opcode 0x0c7a, status 0x03). The kernel sends it right after Write SSP Mode
# whenever mgmt "sc" is on, so SSP looked broken. With SC off, SSP works and
# classic devices pair with Just Works / numeric comparison (no PIN).
# Fallback if SSP still fails: ssp off (legacy PIN pairing, try 0000).
set -u
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
log() { echo "z96a-bt: $*"; }

exec 9>/run/z96a-bt.lock
flock -n 9 || { log "locked"; exit 0; }

btm() { : | timeout "$1" btmgmt "${@:2}"; }

powered_ctl() {
	local out; out=$(timeout 2 bluetoothctl show 2>/dev/null || true)
	[[ "$out" == *"Powered: yes"* ]]
}
cur_settings() {
	btm 5 info 2>/dev/null | sed -n 's/.*current settings: //p' | head -n1 || true
}
powered_hci() {
	local cur; cur=$(cur_settings)
	[[ -n "$cur" && "$cur" == *powered* ]]
}
have_ctrl() {
	local out; out=$(timeout 2 bluetoothctl list 2>/dev/null || true)
	[[ "$out" == *Controller* ]]
}

apply_policy() {
	btm 5 -i hci0 le on >/dev/null 2>&1 || true
	btm 5 -i hci0 bondable on >/dev/null 2>&1 || true
	btm 5 -i hci0 connectable on >/dev/null 2>&1 || true
	btm 5 -i hci0 pairable on >/dev/null 2>&1 || true
	timeout 3 bluetoothctl pairable on >/dev/null 2>&1 || true
	# Not discoverable by default: GNOME's Bluetooth panel turns it on while
	# open (pairing). Paired devices reconnect via page scan (connectable).
	btm 5 -i hci0 discov off >/dev/null 2>&1 || true
}

# $1 = on|off for SSP; SC always off (firmware cannot do it)
power_cycle() {
	btm 5 -i hci0 power off >/dev/null 2>&1 || true
	sleep 1
	# kernel rejects "sc off" while SSP is off on an SC-capable controller
	btm 5 -i hci0 ssp "$1" >/dev/null 2>&1 || true
	btm 5 -i hci0 sc off >/dev/null 2>&1 || true
	btm 5 -i hci0 le on >/dev/null 2>&1 || true
	btm 5 -i hci0 bondable on >/dev/null 2>&1 || true
	btm 8 -i hci0 power on >/dev/null 2>&1 || true
	sleep 1
}

bring_up() {
	local cur
	cur=$(cur_settings)
	if [[ "$cur" != *powered* || "$cur" != *ssp* || "$cur" == *secure-conn* ]]; then
		log "sc off + ssp on + power on"
		power_cycle on
		cur=$(cur_settings)
	fi
	if [[ "$cur" != *powered* ]]; then
		log "ssp power-on failed, fallback ssp off (PIN pairing)"
		power_cycle off
		cur=$(cur_settings)
	fi
	[[ "$cur" == *powered* ]] || return 1
	apply_policy
	return 0
}

log "wait hci0"
for _ in $(seq 1 40); do [[ -d /sys/class/bluetooth/hci0 ]] && break; sleep 1; done
if [[ ! -d /sys/class/bluetooth/hci0 && -e /sys/bus/serial/devices/serial0-0 ]]; then
	log "rebind"
	echo serial0-0 > /sys/bus/serial/drivers/hci_uart_h5/unbind 2>/dev/null || true
	sleep 2
	echo serial0-0 > /sys/bus/serial/drivers/hci_uart_h5/bind 2>/dev/null || true
	for _ in $(seq 1 30); do [[ -d /sys/class/bluetooth/hci0 ]] && break; sleep 1; done
fi
[[ -d /sys/class/bluetooth/hci0 ]] || { log "no hci0"; exit 1; }
log "hci0 ok"
rfkill unblock bluetooth 2>/dev/null || true

log "start bluetoothd"
systemctl start bluetooth.service || true
for i in $(seq 1 25); do
	have_ctrl && { log "controller ${i}s"; break; }
	sleep 1
done
have_ctrl || { log "no controller"; exit 1; }
sleep 1

if bring_up && { powered_ctl || powered_hci; }; then
	log "Powered: yes cur=$(cur_settings)"
	exit 0
fi
log "fail cur=$(cur_settings)"
exit 1
