#!/bin/bash
# Z96A speaker path on mainline RK817 + AW8737 (simple-audio-amplifier).
# Vendor uses HP channel + spk-ctl GPIO3_PA6; amp is gated by DAPM pin
# "Internal Speakers". Playback Mux must be HP (not Class-D SPK).
#
# Apply once and exit — do not hold for tens of seconds (that stalled boot).

set -u
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

log() { echo "z96a-ensound: $*"; }

find_card() {
	local CARD="" c n
	while read -r idx name rest; do
		case "$name" in
			*[Rr][Kk]817*|*[Rr][Kk]809*|*Analog*) CARD="$idx"; break ;;
		esac
	done < <(grep -E '^ *[0-9]+ ' /proc/asound/cards 2>/dev/null || true)

	if [[ -z "$CARD" ]]; then
		for c in /proc/asound/card[0-9]*; do
			[[ -d "$c" ]] || continue
			n="${c##*card}"
			if amixer -c "$n" sget 'Playback Mux' >/dev/null 2>&1 \
				|| amixer -c "$n" sget 'Playback Path' >/dev/null 2>&1; then
				CARD="$n"
				break
			fi
		done
	fi
	printf '%s' "$CARD"
}

apply_spk() {
	local CARD="$1"

	if amixer -c "$CARD" sget 'Playback Mux' >/dev/null 2>&1; then
		amixer -c "$CARD" -q set 'Playback Mux' HP || return 1
	elif amixer -c "$CARD" sget 'Playback Path' >/dev/null 2>&1; then
		amixer -c "$CARD" -q set 'Playback Path' SPK \
			|| amixer -c "$CARD" -q set 'Playback Path' SPK_HP \
			|| return 1
	fi

	for ctl in 'Internal Speakers' 'Speaker Amplifier Speaker' \
		'Speaker' 'Master' 'Headphone' 'DAC' 'Playback'; do
		amixer -c "$CARD" -q set "$ctl" unmute 2>/dev/null || true
		amixer -c "$CARD" -q set "$ctl" on 2>/dev/null || true
		amixer -c "$CARD" -q set "$ctl" 80% 2>/dev/null || true
	done

	mkdir -p /etc/alsa /run
	echo "$CARD" > /run/z96a-alsa-card
	cat > /etc/asound.conf <<EOF
pcm.!default {
	type plug
	slave.pcm "qhw"
}
pcm.qhw {
	type hw
	card $CARD
}
ctl.!default {
	type hw
	card $CARD
}
EOF
	return 0
}

for _ in $(seq 1 20); do
	[[ -d /proc/asound ]] && [[ -n "$(find_card)" ]] && break
	sleep 1
done

CARD="$(find_card)"
if [[ -z "$CARD" ]]; then
	log "ERROR: no RK817 card found"
	cat /proc/asound/cards 2>/dev/null || true
	exit 1
fi

log "using ALSA card $CARD (HP mux + Internal Speakers amp)"
if ! apply_spk "$CARD"; then
	log "ERROR: failed to enable speaker path on card $CARD"
	exit 1
fi

log "speaker path set on card $CARD"
amixer -c "$CARD" sget 'Playback Mux' 2>/dev/null || true
amixer -c "$CARD" sget 'Internal Speakers' 2>/dev/null || true
exit 0
