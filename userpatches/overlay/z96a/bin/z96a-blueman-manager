#!/bin/bash
# Fast path for Blueman Manager on Z96A.
# Tray click toggles a single-instance app; a hung previous manager makes
# the next click wait minutes. KillSwitch+rfkill also makes startup hide the
# window while PowerManager blocks on "enable bluetooth".

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

# Drop any stuck single-instance manager (D-Bus Activate would wait on it).
killall -9 blueman-manager 2>/dev/null || true

# Keep window on-screen; avoid hide()+check_bluetooth_status hang path when
# PowerManager thinks BT is off due to KillSwitch/rfkill races.
if command -v gsettings >/dev/null 2>&1; then
	gsettings set org.blueman.plugins.powermanager auto-power-on false 2>/dev/null || true
	gsettings set org.blueman.general plugin-list "['!KillSwitch']" 2>/dev/null || true
	gsettings set org.blueman.general window-properties "[640, 480, 80, 80]" 2>/dev/null || true
fi

# Soft power-on via BlueZ only (do not rfkill power-cycle).
bluetoothctl power on >/dev/null 2>&1 || true

exec /usr/bin/blueman-manager "$@"
