#!/bin/bash
# Start Blueman only after a short hci0 check. Do NOT call gsettings here —
# that can block for minutes on a half-ready session bus and makes the
# tray/menu take forever to open blueman-manager.
# auto-power-on=false is set system-wide via dconf (02-z96a-blueman).

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

# z96a-bt-ready runs Before=display-manager, so hci0 is usually already up.
# Cap any wait so the applet never stalls the desktop for minutes.
for _ in $(seq 1 15); do
	if [[ -d /sys/class/bluetooth/hci0 ]] && \
		systemctl is-active --quiet bluetooth.service 2>/dev/null; then
		break
	fi
	sleep 1
done

exec /usr/bin/blueman-applet "$@"
